{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "worknotes",
  "version": "1.1.0",
  "identifier": "io.github.jdhdev.worknotes",
  "mainBinaryName": "worknotes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "worknotes",
        "width": 1200,
        "height": 760
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "JDHDEV",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
